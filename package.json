{
  "name": "atomsystem",
  "version": "0.15.2",
  "type": "module",
  "homepage": "https://system.atomground.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsy1023/AtomDesignToken.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "atomsystem": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.json": "./tokens/tokens.json",
    "./token.json": "./tokens/tokens.json",
    "./tokens": "./tokens/tokens.json",
    "./studio.registry.json": "./tokens/tokens.json",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "require": "./dist/themes.cjs"
    },
    "./design.md": "./presets/default.design.md",
    "./uxPattern.md": "./presets/uxPattern.md",
    "./skill": "./skills/atomsystem.skill.md",
    "./components/*": "./components/ui/*.tsx",
    "./blocks/*": "./components/blocks/*.tsx",
    "./css/atom-ui.css": "./css/atom-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens",
    "presets",
    "skills",
    "components/ui",
    "components/blocks",
    "css",
    "atom.design.md",
    "atom.uxPattern.md",
    "tailwind.config.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepublishOnly": "npm run build:lib",
    "postinstall": "node dist/cli.js postinstall",
    "bump:version": "tsx scripts/bump-version.ts",
    "generate:dist": "tsx scripts/generate-package-distribution.ts",
    "build:lib": "npm run generate:dist && tsup && node scripts/build-studio-spa.mjs",
    "pack:lib": "npm run build:lib && npm pack",
    "example:mib": "npm --prefix examples/mib-browser run dev",
    "example:mib:build": "npm --prefix examples/mib-browser run build",
    "example:mib:test": "npm --prefix examples/mib-browser run test:e2e",
    "start": "next start",
    "lint": "next lint",
    "lint:design": "impeccable detect app components css",
    "lint:components": "node scripts/lint-components.cjs",
    "refactor": "tsx src/cli.ts refactor",
    "refactor:check": "tsx src/cli.ts refactor --check",
    "refactor:fix": "tsx src/cli.ts refactor --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "inquirer": "^12.4.2",
    "lucide-react": "^1.7.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.4.6",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.39",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "highlight.js": "^11.11.1",
    "impeccable": "^4.8.2",
    "next": "^15.0.3",
    "next-intl": "^4.15.0",
    "playwright": "^1.51.1",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
